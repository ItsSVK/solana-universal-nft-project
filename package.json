{
  "name": "universal-nft-protocol",
  "version": "1.0.0",
  "description": "Cross-chain NFT protocol enabling seamless transfers across Solana, ZetaChain, and Base Sepolia",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/test-all.js",
    "test:integration": "node scripts/test-integration.js",
    "test:e2e": "node scripts/run-e2e-tests.js",
    "test:e2e:required": "node scripts/run-e2e-tests.js --skip-optional",
    "test:e2e:performance": "node scripts/run-e2e-tests.js --performance-only",
    "test:e2e:security": "node scripts/run-e2e-tests.js --security-only",
    "test:enhanced": "npx mocha --require ts-node/register test/EndToEndEnhanced.test.ts --timeout 300000",
    "test:performance": "npx mocha --require ts-node/register test/PerformanceAndLoad.test.ts --timeout 600000",
    "test:security": "npx mocha --require ts-node/register test/SecurityAndRobustness.test.ts --timeout 300000",
    "test:security:legacy": "cd contracts/solana/universal_nft && ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-~/.config/solana/id.json} mocha --require ts-node/register ../../../test/**/*.test.ts --grep 'Security' --timeout 60000",
    "test:watch": "cd contracts/solana/universal_nft && ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-~/.config/solana/id.json} mocha --require ts-node/register ../../../test/**/*.test.ts --watch --timeout 30000",
    "test:solana": "cd contracts/solana/universal_nft && anchor test",
    "test:solana-unit": "cd contracts/solana/universal_nft && ANCHOR_PROVIDER_URL=${ANCHOR_PROVIDER_URL:-http://127.0.0.1:8899} ANCHOR_WALLET=${ANCHOR_WALLET:-~/.config/solana/id.json} yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.test.ts",
    "coverage": "nyc npm test",
    "build": "npm run build:shared && npm run build:contracts",
    "build:shared": "tsc --project tsconfig.shared.json",
    "build:contracts": "npm run build:solidity && npm run build:solana",
    "build:solidity": "hardhat compile",
    "build:solana": "cd contracts/solana/universal_nft && anchor build",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "deploy:zetachain": "hardhat run scripts/deploy-zetachain.js --network zetachain-testnet",
    "deploy:base": "hardhat run scripts/deploy-base.js --network base-sepolia",
    "deploy:solana": "cd contracts/solana/universal_nft && anchor deploy --provider.cluster devnet",
    "prepare": "husky install"
  },
  "keywords": [
    "nft",
    "cross-chain",
    "zetachain",
    "solana",
    "base",
    "blockchain",
    "defi",
    "web3"
  ],
  "author": "Universal NFT Protocol Team",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.95.8",
    "@zetachain/protocol-contracts": "^13.0.0",
    "@zetachain/toolkit": "^16.0.0",
    "ethers": "^6.14.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "chai": "^4.3.10",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "hardhat": "^2.19.2",
    "hardhat-gas-reporter": "^1.0.9",
    "husky": "^8.0.3",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.1.1",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/universal-nft-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/universal-nft-protocol/issues"
  },
  "homepage": "https://github.com/your-org/universal-nft-protocol#readme",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
